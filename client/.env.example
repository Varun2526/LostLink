# Copy to .env for local development:
#   cp .env.example .env
#
# Must point at the /api prefix. If you leave the /api off it is added
# automatically, and if this variable is missing entirely the app falls
# back to the deployed Render backend.

# local backend
VITE_API_URL=http://localhost:5001/api

# deployed backend (set this one in the Vercel dashboard)
# VITE_API_URL=https://lostlink-3mkr.onrender.com/api
