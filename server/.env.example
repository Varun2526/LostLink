# Copy this file to .env and fill in your own values:
#   cp .env.example .env

# Server
PORT=5001
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/lostlink

# Auth
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
# access token lifetime (short - the refresh token keeps the session alive)
JWT_EXPIRES_IN=15m
# refresh token lifetime in days
REFRESH_TOKEN_DAYS=7

# Frontend
CLIENT_URL=http://localhost:5173

# Cloudinary (image uploads). Leave blank to disable uploads - the API
# then returns a clear "not configured" message instead of crashing.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
